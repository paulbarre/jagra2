DEV_SERVER_PORT=3000
# Which content collection is mounted: 'rules' or 'kanjis'. Restart the dev
# server / rebuild after changing this.
NUXT_PUBLIC_CONTENT_COLLECTION=rules
# Displayed app name (page header + browser tab title).
NUXT_PUBLIC_APP_NAME=Jagra
# UI color palette: 'sakura' (rose/indigo/stone), 'sumi' (indigo/rose/zinc)
# or 'matcha' (green/amber/stone). Restart after changing this.
NUXT_PUBLIC_UI_THEME=sakura
